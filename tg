    """Admin command to restore the database from a JSON file.
    Usage: Reply to a valid backup JSON file with /restore
    """
    message = update.message
    if not message.reply_to_message or not message.reply_to_message.document:
        await message.reply_text(
            "❌ *How to restore:* Reply to a valid backup `.json` file with `/restore`.",
            parse_mode="Markdown"
        )
