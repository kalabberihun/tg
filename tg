async def handle_confession(update: Update,
                                context: ContextTypes.DEFAULT_TYPE) -> None:
        """Receives a message from a private chat and handles it as a comment, feedback, or new confession (supports text/media)."""
        user_id = update.effective_user.id
        user_alias = get_user_alias(user_id)
        
        # Check text or caption
        text: str = ""
        if update.message.text:
            text = update.message.text.strip()
        elif update.message.caption:
            text = update.message.caption.strip()

        # Capture media
        media_file_id: str = None
        media_type: str = None

        if update.message.photo:
            media_file_id = update.message.photo[-1].file_id
            media_type = "photo"
        elif update.message.video:
            media_file_id = update.message.video.file_id
            media_type = "video"
        elif update.message.voice:
            media_file_id = update.message.voice.file_id
            media_type = "voice"
        elif update.message.audio:
            media_file_id = update.message.audio.file_id
            media_type = "audio"
        elif update.message.animation:
            media_file_id = update.message.animation.file_id
            media_type = "animation"

        # Check for empty submission
        if not text and not media_file_id:
            await update.message.reply_text(
                "Please send text or a supported media file (photo, video, voice, audio, GIF) for your confession."
            )
            return

        user_state = context.user_data.get(user_id)
        is_submitting_confession = not user_state or user_state.get('state') not in ['awaiting_reply', 'awaiting_comment_reply', 'awaiting_feedback']

        # Rate Limit Check
        if is_submitting_confession:
            now = time.time()
            if user_id in last_submission_time:
                elapsed = now - last_submission_time[user_id]
                if elapsed < RATE_LIMIT_SECONDS:
                    remaining = int(RATE_LIMIT_SECONDS - elapsed)
                    await update.message.reply_text(
                        f"☕ *Slow down!* Please wait {remaining} seconds before sending another confession.",
                        parse_mode="Markdown"
                    )
                    return
            last_submission_time[user_id] = now

        # State: Awaiting Reply (to an original Confession)
        if user_state and user_state.get('state') == 'awaiting_reply':
            conf_id_to_reply_to = user_state.get('conf_id')
            del context.user_data[user_id]

            if conf_id_to_reply_to is None:
                await update.message.reply_text("⚠️ Cannot submit comment: Invalid context.")
                return

            conf_key = str(conf_id_to_reply_to)
            if conf_key not in store["posted"]:
                await update.message.reply_text("⚠️ Cannot submit comment: The confession no longer exists.")
                return

            reply_id = store['next_id']
            store["next_id"] += 1

            posted_confession = store["posted"][conf_key]
            if "replies" not in posted_confession:
                posted_confession["replies"] = []

            posted_confession["replies"].append({
                "reply_id": reply_id,
                "text": text if text else "[Media/No Text]",
                "user_alias": user_alias,
                "approved_time": update.message.date.astimezone(utc).isoformat(),
                "voters": {}
            })
            save_store()

            # Show updated comments page
            new_index = len(posted_confession["replies"]) - 1
            page_text, page_markup = get_comment_page_text_and_markup(conf_id_to_reply_to, new_index, user_id)
            await update.message.reply_text("✅ Your comment has been posted!")
            await update.message.reply_text(page_text, parse_mode="Markdown", reply_markup=page_markup)
            return

        # State: Awaiting Comment Reply (to an existing Comment)
        if user_state and user_state.get('state') == 'awaiting_comment_reply':
            target_conf_id = user_state.get('conf_id')
            target_reply_id = user_state.get('reply_id')
            index = user_state.get('index', 0)
            del context.user_data[user_id]

            if target_conf_id is None or target_reply_id is None:
                await update.message.reply_text("⚠️ Cannot submit reply: Invalid context.")
                return

            conf_key = str(target_conf_id)
            if conf_key not in store["posted"]:
                await update.message.reply_text("⚠️ The original confession no longer exists.")
                return

            replies = store["posted"][conf_key]["replies"]
            target_comment_index = -1
            for i, reply in enumerate(replies):
                if reply.get('reply_id') == target_reply_id:
                    target_comment_index = i
                    break

            if target_comment_index == -1:
                await update.message.reply_text("⚠️ The comment you are replying to no longer exists.")
                return

            replying_to_alias = replies[target_comment_index].get('user_alias', 'Anonymous')
            reply_text_full = f"*Reply to {replying_to_alias}:* {text if text else '[Media/No Text]'}"

            new_reply_id = store['next_id']
            store["next_id"] += 1

            replies.append({
                "reply_id": new_reply_id,
                "text": reply_text_full,
                "user_alias": user_alias,
                "approved_time": update.message.date.astimezone(utc).isoformat(),
                "voters": {}
            })
            save_store()

            new_index = len(replies) - 1
            page_text, page_markup = get_comment_page_text_and_markup(target_conf_id, new_index, user_id)
            await update.message.reply_text("✅ Your reply has been posted!")
            await update.message.reply_text(page_text, parse_mode="Markdown", reply_markup=page_markup)
            return

        # State: Awaiting Feedback
        if user_state and user_state.get('state') == 'awaiting_feedback':
            del context.user_data[user_id]

            try:
                await context.bot.send_message(
                    chat_id=ADMIN_GROUP_ID,
                    text=f"✉️ *New Anonymous Feedback*\n\n{text}",
                    parse_mode="Markdown",
                )
                await update.message.reply_text("✅ Your feedback has been sent to the administrators. Thank you!")
            except Exception as e:
                logger.error(f"Failed to send feedback to admin group: {e}")
                await update.message.reply_text("⚠️ Error: Could not send feedback. Please try again later.")
            return

        # Default: New Confession
        await submit_pending_confession(update, context, text, media_file_id, media_type)


async def handle_callbacks(update: Update,
                               context: ContextTypes.DEFAULT_TYPE) -> None:
        """Handles inline button presses."""
        query = update.callback_query
        await query.answer()

        action_data = query.data.split("|")

        # --- 1. Channel Reactions ---
        if action_data[0] in ["like_conf", "dislike_conf"]:
            action = action_data[0]
            conf_id_str = action_data[1]
            user_id = str(update.effective_user.id)

            conf_key = str(conf_id_str)
            if conf_key not in store["posted"]:
                await query.answer("⚠️ Confession not found.")
                return

            posted_conf = store["posted"][conf_key]
            if "voters" not in posted_conf:
                posted_conf["voters"] = {}
            voters = posted_conf["voters"]

            vote_type = "like" if action == "like_conf" else "dislike"
            previous_vote = voters.get(user_id)

            if previous_vote == vote_type:
                del voters[user_id]
                message_text = "Vote removed!"
            elif previous_vote and previous_vote != vote_type:
                voters[user_id] = vote_type
                message_text = f"Vote changed to {vote_type}!"
            else:
                voters[user_id] = vote_type
                message_text = "Vote counted!"

            posted_conf["voters"] = voters
            save_store()

            likes = sum(1 for v in voters.values() if v == 'like')
            dislikes = sum(1 for v in voters.values() if v == 'dislike')

            bot_info = await context.bot.get_me()
            bot_username = bot_info.username

            reply_keyboard = [
                [
                    InlineKeyboardButton(f"👍 Like ({likes})", callback_data=f"like_conf|{conf_id_str}"),
                    InlineKeyboardButton(f"👎 Dislike ({dislikes})", callback_data=f"dislike_conf|{conf_id_str}")
                ],
                [
                    InlineKeyboardButton("💬 Add / View Comments", url=f"https://t.me/{bot_username}?start=comment_{conf_id_str}")
                ]
            ]
            try:
                await query.edit_message_reply_markup(reply_markup=InlineKeyboardMarkup(reply_keyboard))
            except Exception as e:
                logger.error(f"Failed to update channel reply markup: {e}")

            await query.answer(message_text)
            return

        # --- 2. Public Comment Interactivity ---
        if action_data[0] == "browse_comments":
            conf_id = int(action_data[1])
            index = int(action_data[2]) if len(action_data) > 2 else 0
            text, markup = get_comment_page_text_and_markup(conf_id, index, query.from_user.id)
            if query.message.caption:
                await query.edit_message_caption(caption=text, parse_mode="Markdown", reply_markup=markup)
            else:
                await query.edit_message_text(text, parse_mode="Markdown", reply_markup=markup)
            return

        if action_data[0] == "vote_comment":
            conf_id = int(action_data[1])
            reply_id = int(action_data[2])
            vote_type = action_data[3]
            index = int(action_data[4])
            user_id = str(query.from_user.id)

            conf_key = str(conf_id)
            if conf_key not in store["posted"]:
                await query.answer("Confession not found.")
                return

            replies = store["posted"][conf_key].get("replies", [])
            target_reply = None
            for r in replies:
                if r.get('reply_id') == reply_id:
                    target_reply = r
                    break

            if not target_reply:
                await query.answer("Comment not found.")
                return

            voters = target_reply.get('voters', {})
            previous_vote = voters.get(user_id)

            if previous_vote == vote_type:
                del voters[user_id]
                message_text = "Vote removed!"
            elif previous_vote and previous_vote != vote_type:
                voters[user_id] = vote_type
                message_text = f"Vote changed to '{vote_type}'!"
            else:
                voters[user_id] = vote_type
                message_text = f"{vote_type.capitalize()} counted!"

            target_reply['voters'] = voters
            save_store()

            text, markup = get_comment_page_text_and_markup(conf_id, index, query.from_user.id)
            if query.message.caption:
                await query.edit_message_caption(caption=text, parse_mode="Markdown", reply_markup=markup)
            else:
                await query.edit_message_text(text, parse_mode="Markdown", reply_markup=markup)
            await query.answer(message_text)
            return

        if action_data[0] == "reply_comment":
            conf_id = int(action_data[1])
            reply_id = int(action_data[2])
            index = int(action_data[3])
            user_id = query.from_user.id
            user_alias = get_user_alias(user_id)

            context.user_data[user_id] = {
                'state': 'awaiting_comment_reply',
                'conf_id': conf_id,
                'reply_id': reply_id,
                'index': index
            }

            conf_key = str(conf_id)
            replies = store["posted"][conf_key].get("replies", [])
            target_reply = None
            for r in replies:
                if r.get('reply_id') == reply_id:
                    target_reply = r
                    break

            if not target_reply:
                await query.answer("Comment not found.")
                return

            comment_author_alias = target_reply.get('user_alias', 'Anonymous')
            response_text = (
                f"💬 *You are submitting a REPLY to {comment_author_alias}'s comment:*\n"
                f"> _{target_reply['text']}_\n\n"
                f"Your alias for this reply: *{user_alias}*\n\n"
                f"Please send your reply message now. Or `/cancel` to abort."
            )
            if query.message.caption:
                await query.edit_message_caption(caption=response_text, parse_mode="Markdown")
            else:
                await query.edit_message_text(response_text, parse_mode="Markdown")
            return

        if action_data[0] in ["view_confession", "add_comment"]:
            action, data_id = action_data[0], action_data[1]
            try:
                conf_id = int(data_id)
            except (IndexError, ValueError):
                await query.answer("Invalid confession ID.")
                return

            confession_data = store["posted"].get(str(conf_id))
            if not confession_data:
                await query.answer("⚠️ Confession not found.")
                return

            if action == "view_confession":
                await send_confession_options(update, context, conf_id)
                return

            elif action == "add_comment":
                user_id = update.effective_user.id
                user_alias = get_user_alias(user_id)

                context.user_data[user_id] = {
                    'state': 'awaiting_reply',
                    'conf_id': conf_id
                }

                response_text = (
                    f"💬 *You are submitting a comment to Confession #{conf_id}* (as *{user_alias}*):\n\n"
                    f"> _{confession_data['text'][:150]}..._\n\n"
                    f"Please send your comment now."
                )
                if query.message.caption:
                    await query.edit_message_caption(caption=response_text, parse_mode="Markdown")
                else:
                    await query.edit_message_text(response_text, parse_mode="Markdown")
                return

        # --- 3. Admin Actions ---
        if query.message.chat.id != ADMIN_GROUP_ID:
            return

        if action_data[0] in ["approve", "reject"]:
            if len(action_data) != 2: return
            action, data_id = action_data

            if data_id not in store["pending"]:
                orig = query.message.caption if query.message.caption else query.message.text
                new_text = (orig if orig else "") + "\n\n⚠️ *Already Handled*"
                if query.message.caption:
                    await query.edit_message_caption(caption=new_text, parse_mode="Markdown")
                else:
                    await query.edit_message_text(text=new_text, parse_mode="Markdown")
                return

            pending_item = store["pending"][data_id]
            conf_id = pending_item["id"]
            conf_alias = pending_item["user_alias"]

            orig_text = query.message.caption if query.message.caption else query.message.text
            if not orig_text:
                orig_text = ""

            success_text = orig_text + f"\n\n✅ *Approved by {update.effective_user.first_name}*"
            reject_text = orig_text + f"\n\n❌ *Rejected by {update.effective_user.first_name}*"

            if action == "reject":
                del store["pending"][data_id]
                save_store()
                if query.message.caption:
                    await query.edit_message_caption(caption=reject_text, parse_mode="Markdown")
                else:
                    await query.edit_message_text(text=reject_text, parse_mode="Markdown")

            elif action == "approve":
                conf = store["pending"].pop(data_id)

                temp_conf_data = {
                    "text": conf["text"],
                    "user_alias": conf_alias,
                    "post_time": update.callback_query.message.date.astimezone(utc).isoformat(),
                    "replies": [],
                    "channel_message_id": None,
                    "media_file_id": conf.get("media_file_id"),
                    "media_type": conf.get("media_type"),
                    "voters": {}
                }
                store["posted"][str(conf_id)] = temp_conf_data
                save_store()

                bot_info = await context.bot.get_me()
                bot_username = bot_info.username

                reply_keyboard = [
                    [
                        InlineKeyboardButton("👍 Like (0)", callback_data=f"like_conf|{conf_id}"),
                        InlineKeyboardButton("👎 Dislike (0)", callback_data=f"dislike_conf|{conf_id}")
                    ],
                    [
                        InlineKeyboardButton(
                            "💬 Add / View Comments",
                            url=f"https://t.me/{bot_username}?start=comment_{conf_id}")
                    ]
                ]
                post_text = f"*#{conf_id} Confession* - Posted by: {conf_alias}\n\n{conf['text']}"
                
                media_file_id = conf.get("media_file_id")
                media_type = conf.get("media_type")

                try:
                    if media_type == "photo":
                        sent_message = await context.bot.send_photo(
                            chat_id=CHANNEL_ID, photo=media_file_id, caption=post_text, parse_mode="Markdown", reply_markup=InlineKeyboardMarkup(reply_keyboard))
                    elif media_type == "video":
                        sent_message = await context.bot.send_video(
                            chat_id=CHANNEL_ID, video=media_file_id, caption=post_text, parse_mode="Markdown", reply_markup=InlineKeyboardMarkup(reply_keyboard))
                    elif media_type == "voice":
                        sent_message = await context.bot.send_voice(
                            chat_id=CHANNEL_ID, voice=media_file_id, caption=post_text, parse_mode="Markdown", reply_markup=InlineKeyboardMarkup(reply_keyboard))
                    elif media_type == "audio":
                        sent_message = await context.bot.send_audio(
                            chat_id=CHANNEL_ID, audio=media_file_id, caption=post_text, parse_mode="Markdown", reply_markup=InlineKeyboardMarkup(reply_keyboard))
                    elif media_type == "animation":
                        sent_message = await context.bot.send_animation(
                            chat_id=CHANNEL_ID, animation=media_file_id, caption=post_text, parse_mode="Markdown", reply_markup=InlineKeyboardMarkup(reply_keyboard))
                    else:
                        sent_message = await context.bot.send_message(
                            chat_id=CHANNEL_ID, text=post_text, parse_mode="Markdown", reply_markup=InlineKeyboardMarkup(reply_keyboard))

                    store["posted"][str(conf_id)]["channel_message_id"] = sent_message.message_id
                    save_store()

                    post_link = sent_message.link if sent_message.link else f"https://t.me/{CHANNEL_ID.lstrip('@')}/{sent_message.message_id}"

                    if query.message.caption:
                        await query.edit_message_caption(caption=success_text + f"\n\n🔗 [View Post in Channel]({post_link})", parse_mode="Markdown")
                    else:
                        await query.edit_message_text(text=success_text + f"\n\n🔗 [View Post in Channel]({post_link})", parse_mode="Markdown")

                except Exception as e:
                    logger.error(f"Failed to post Confession #{conf_id} to channel {CHANNEL_ID}: {e}")
                    del store["posted"][str(conf_id)]
                    store["pending"][data_id] = conf
                    save_store()
                    
                    err_msg = orig_text + f"\n\n❌ *Approval Failed: Could not post. Reverted.* Error: {e}"
                    if query.message.caption:
                        await query.edit_message_caption(caption=err_msg, parse_mode="Markdown")
                    else:
                        await query.edit_message_text(text=err_msg, parse_mode="Markdown")
            return


