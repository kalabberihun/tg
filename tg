@is_admin_chat
async def stats_command(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """Displays bot and channel statistics for administrators."""
    total_posted = len(store.get("posted", {}))
    total_pending = len(store.get("pending", {}))
    
    total_comments = 0
    confessions_with_comments = 0
    top_commented = []
    top_liked_confessions = []

    for conf_id, data in store.get("posted", {}).items():
        replies_count = len(data.get("replies", []))
        total_comments += replies_count
        if replies_count > 0:
            confessions_with_comments += 1
            top_commented.append((conf_id, replies_count, data.get("text", "")[:40]))
        
        # Calculate confession votes
        voters = data.get("voters", {})
        likes = sum(1 for v in voters.values() if v == 'like')
        dislikes = sum(1 for v in voters.values() if v == 'dislike')
        net_score = likes - dislikes
        top_liked_confessions.append((conf_id, net_score, likes, dislikes, data.get("text", "")[:40]))

    # Sort to find top confessions
    top_commented.sort(key=lambda x: x[1], reverse=True)
    top_liked_confessions.sort(key=lambda x: x[1], reverse=True)

    stats_text = (
        "📊 *Telegram Confession Bot Statistics*\n\n"
        f"🔹 *Total Confessions Posted:* `{total_posted}`\n"
        f"🔹 *Total Confessions Pending:* `{total_pending}`\n"
        f"🔹 *Total Comments Posted:* `{total_comments}`\n"
        f"🔹 *Active Comment Ratio:* `{confessions_with_comments}/{total_posted}` confessions have comments.\n\n"
    )

    if top_liked_confessions:
        stats_text += "🏆 *Top 3 Most Liked Confessions (Net Score):*\n"
        for i, (conf_id, score, l, d, text) in enumerate(top_liked_confessions[:3], 1):
            stats_text += f"{i}. *#{conf_id}* (Score: `{score}` | 👍{l} 👎{d}): _{text}..._\n"
        stats_text += "\n"

    if top_commented:
        stats_text += "💬 *Top 3 Most Commented Confessions:*\n"
        for i, (conf_id, count, text) in enumerate(top_commented[:3], 1):
            stats_text += f"{i}. *#{conf_id}* (`{count}` comments): _{text}..._\n"
    
    await update.message.reply_text(stats_text, parse_mode="Markdown")


@is_admin_chat
async def delete_confession_command(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
      """Admin command to delete a posted confession."""
      if not context.args:
          await update.message.reply_text("Usage: `/deleteconfession <id>`")
          return
      try:
          conf_id = context.args[0]
          if conf_id in store["posted"]:
              # Delete the message in the channel if we can
              conf_data = store["posted"][conf_id]
              msg_id = conf_data.get("channel_message_id")
              if msg_id:
                  try:
                      await context.bot.delete_message(chat_id=CHANNEL_ID, message_id=msg_id)
                  except Exception as e:
                      logger.warning(f"Could not delete message from channel: {e}")
              del store["posted"][conf_id]
              save_store()
              await update.message.reply_text(f"✅ Confession #{conf_id} deleted successfully.")
          else:
              await update.message.reply_text("❌ Confession not found.")
      except Exception as e:
          await update.message.reply_text(f"❌ Error: {e}")


@is_admin_chat
async def delete_comment_command(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
      """Admin command to delete a specific comment (1-based index)."""
      if len(context.args) < 2:
          await update.message.reply_text("Usage: `/deletecomment <confession_id> <comment_index>`")
          return
      try:
          conf_id = context.args[0]
          comment_index = int(context.args[1]) - 1 # Convert to 0-based index
          
          if conf_id not in store["posted"]:
              await update.message.reply_text("❌ Confession not found.")
              return
          
          replies = store["posted"][conf_id].get("replies", [])
          if comment_index < 0 or comment_index >= len(replies):
              await update.message.reply_text(f"❌ Invalid comment index. Comment count: {len(replies)}")
              return
          
          removed = replies.pop(comment_index)
          save_store()
          await update.message.reply_text(f"✅ Comment index {comment_index + 1} (ID: {removed.get('reply_id')}) removed.")
      except Exception as e:
          await update.message.reply_text(f"❌ Error: {e}")


@is_admin_chat
async def reset_counter_command(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
      """Danger: clears the entire database and resets the ID counter."""
      store["next_id"] = 1
      store["pending"] = {}
      store["posted"] = {}
      store["user_profiles"] = {}
      save_store()
      await update.message.reply_text("⚠️ **Database has been completely reset.** Counter set to 1.")


