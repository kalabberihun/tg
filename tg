def check_auto_moderation(text: str) -> List[str]:
    """Checks if confession contains toxic keywords and returns flagged words."""
    found = []
    text_lower = text.lower()
    for word in TOXIC_KEYWORDS:
        if word in text_lower:
            found.append(word)
    return found

