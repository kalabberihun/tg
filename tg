def get_user_alias(user_id: int) -> str:
        """Retrieves the stored nickname or generates a fun, persistent random one."""
        user_id_str = str(user_id)
        if user_id_str not in store.get("user_profiles", {}):
            adj = random.choice(ADJECTIVES)
            noun = random.choice(NOUNS)
            num = random.randint(1, 9)
            generated_alias = f"{adj}{noun}{num}"
            if "user_profiles" not in store:
                store["user_profiles"] = {}
            store["user_profiles"][user_id_str] = generated_alias
            save_store()
        return store["user_profiles"].get(user_id_str, "Anonymous")


